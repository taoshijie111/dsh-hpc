{
  "name": "multiservers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness plugin for remote server management.",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace dsh-multiservers",
    "typecheck": "npm run typecheck --workspace dsh-multiservers",
    "test": "npm run test --workspace dsh-multiservers",
    "probe:ssh": "node scripts/dev/ssh-probe.mjs"
  }
}
