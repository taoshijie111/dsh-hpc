{
  "name": "dsh-hpc-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Workspace for the dsh-hpc DeepSeek Harness plugin.",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "packages/*"
