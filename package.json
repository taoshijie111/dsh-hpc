{
  "name": "multiservers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first project kernel; remote servers as compute and storage resources.",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:protocol && npm run build:carrier",
    "build:protocol": "tsc -p packages/carrier-protocol/tsconfig.json",
    "build:carrier": "tsc -p packages/web-carrier/tsconfig.json",
    "typecheck": "tsc -p packages/carrier-protocol/tsconfig.json --noEmit && tsc -p packages/web-carrier/tsconfig.json --noEmit",
    "test:carrier": "node scripts/dev/carrier-smoke.mjs",
    "probe:ssh": "node scripts/dev/ssh-probe.mjs"
  },
  "dependencies": {
    "ssh2": "^1.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ssh2": "^1.15.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
