{
  "name": "dsh-hpc",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin for HPC and remote servers: pooled SSH connections, sticky sessions, Slurm/bare-metal background jobs, resumable transfers, and a settings panel.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node test/tools-smoke.mjs",
    "test:session": "node test/session-smoke.mjs",
    "test:transfer": "node test/transfer-smoke.mjs",
    "test:transfer:big": "node test/transfer-big.mjs",
    "test:transfer:queue": "node test/transfer-queue.mjs",
    "test:parent-dir": "node test/parent-dir.mjs"
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <5",
    "@deepseek-ai/dsh-credentials": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-settings": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/schemastery": ">=3.18.2 <4",
    "@deepseek-ai/dsh-jobs": ">=0.2.1-rc.2 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@types/node": "^24.7.0",
    "@types/ssh2": "^1.15.5",
    "typescript": "^5.9.3",
    "@deepseek-ai/dsh-jobs": "0.2.1-rc.2"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "hpc",
    "slurm",
    "ssh",
    "sftp",
    "cluster",
    "remote"
  ],
  "license": "MIT",
  "author": "dsh-hpc contributors"
}
